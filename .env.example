# AnfragePro production environment
NODE_ENV=production
PORT=3000

# Required in production
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
APP_URL=https://anfragepro.onrender.com

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=AnfragePro <noreply@example.com>

# Optional admin access
ADMIN_EMAIL=admin@example.com

# Required only for the GitHub E2E provisioning workflow
E2E_PROVISION_SECRET=replace-with-a-separate-long-random-secret
